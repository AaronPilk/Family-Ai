# React Native / Metro expect a flat node_modules layout. pnpm's default symlinked
# structure breaks resolution of transitive runtime helpers like @babel/runtime.
# Hoisting all deps to the root fixes this and matches how npm/yarn behave.
shamefully-hoist=true
node-linker=hoisted

# Make sure Expo's babel preset and reanimated plugin are always visible at the top
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*metro*
